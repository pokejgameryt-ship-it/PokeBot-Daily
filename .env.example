# Plantilla para host gratuito (Quaxly Host / bot-hosting.net)
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo ni al host por git.

# Token del bot de Discord (obligatorio)
POKEBOT_TOKEN=

# ID de instancia único para este host (lease de líder; ej. "quaxly-1")
INSTANCE_ID=

# Credenciales de Firebase como JSON en una sola línea (obligatorio)
# Copia el contenido completo de firebase-service-account.json y pégalo aquí:
FIREBASE_SERVICE_ACCOUNT=

# Servidor web (dejar 0 en el host gratuito; solo para callback OAuth)
ENABLE_WEB_SERVER=0

# Verificación YouTube por screenshot (Tesseract NO existe en host gratuito -> degrada solo)
# No hace falta definir nada: verify.py detecta la ausencia automáticamente.

# Twitch / Google OAuth (opcionales; sin ellos esas rutas de verificación se deshabilitan)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
